# Advisory style for this repo (not CI-enforced: existing sources are
# grandfathered — their hand-aligned tables predate this file and diverge
# from canonical output in ~all files, so only NEW code is expected to
# comply; run clang-format --dry-run --Werror on changed files locally).
# Keys kept compatible with clang-format 10 (booleans, no ReferenceAlignment).
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
PointerAlignment: Right
SortIncludes: false
ReflowComments: false
AllowShortFunctionsOnASingleLine: None
BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements
