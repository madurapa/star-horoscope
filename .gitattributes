# Enforce LF checkouts everywhere: byte-exact goldens and line parsers
# break silently under core.autocrlf (Windows runners default it true).
* text=auto
*.txt text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cmake text eol=lf
*.asm text eol=lf
*.idc text eol=lf
*.TXT text eol=lf
*.json text eol=lf
CMakeLists.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
# Binaries: never convert.
*.EXE binary
*.i64 binary
